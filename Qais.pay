import os
import requests
from telegram import Update
from telegram.ext import Application, MessageHandler, filters, ContextTypes
import google.generativeai as genai

# تنظیم توکن‌ها
TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN", "")
COMPOSIO_API_KEY = os.getenv("COMPOSIO_API_KEY", "")
genai.configure(api_key=os.getenv("GEMINI_API_KEY", ""))

model = genai.GenerativeModel("gemini-1.5-flash")

# تابع جستجو در گوگل از طریق کامپوزیا
def search_web(query):
    url = "https://composio.dev"
    headers = {"X-API-Key": COMPOSIO_API_KEY, "Content-Type": "application/json"}
    payload = {"input": {"query": query}}
    try:
        response = requests.post(url, json=payload, headers=headers, timeout=15)
        return response.json().get("output", "اطلاعاتی پیدا نشد.")
    except:
        return "خطا در اتصال به موتور جستجو."

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_text = update.message.text
    waiting_message = await update.message.reply_text("در حال جستجو و بررسی در وب... 🔍")
    
    # ۱. جستجو در وب
    search_result = search_web(user_text)
    
    # ۲. هوش مصنوعی جمینای پاسخ را مرتب می‌کند
    prompt = f"سوال کاربر: {user_text}\n\nنتایج جستجوی وب: {search_result}\n\nبا توجه به نتایج بالا، یک پاسخ کامل، دقیق و به زبان فارسی روان برای کاربر بنویس."
    try:
        ai_response = model.generate_content(prompt).text
        await waiting_message.edit_text(ai_response)
    except:
        await waiting_message.edit_text("متأسفانه خطایی در پردازش هوش مصنوعی رخ داد.")

def main():
    app = Application.builder().token(TELEGRAM_BOT_TOKEN).build()
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    app.run_polling()

if __name__ == "__main__":
    main()
